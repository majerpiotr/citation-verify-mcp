{
  "name": "citation-verify-mcp",
  "version": "0.0.1",
  "description": "MCP server that verifies whether agent citations resolve against PageIndex",
  "license": "MIT",
  "author": "Piotr Majer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majerpiotr/citation-verify-mcp.git"
  },
  "homepage": "https://github.com/majerpiotr/citation-verify-mcp#readme",
  "bugs": {
    "url": "https://github.com/majerpiotr/citation-verify-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "citation-verification",
    "hallucination-detection",
    "pageindex",
    "rag"
  ],
  "type": "module",
  "bin": { "citation-verify-mcp": "dist/index.js" },
  "main": "./dist/pageindex-client.js",
  "types": "./dist/pageindex-client.d.ts",
  "exports": {
    ".": { "types": "./dist/pageindex-client.d.ts", "default": "./dist/pageindex-client.js" },
    "./grammar": { "types": "./dist/grammar.d.ts", "default": "./dist/grammar.js" },
    "./resolver": { "types": "./dist/resolver.d.ts", "default": "./dist/resolver.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "vitest": "^4.1.0",
    "tsx": "^4.23.0",
    "@types/node": "^24.0.0"
  }
}
